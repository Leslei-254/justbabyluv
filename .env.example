# Copy this file to .env and fill in values as needed.
# Sensible local defaults are shown below — the app runs out of the box
# with no external services configured.

# SQLite (libSQL) database file. Local file path works for development;
# point this at a Turso (libSQL) URL for a hosted production database.
DATABASE_URL="file:./data/justbabyluv.db"

# NextAuth.js secret used to sign session tokens.
# Generate a real value for production with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Base URL of the app (used by NextAuth for callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Optional: Resend API key for sending real reminder emails.
# Leave blank to use the safe local fallback, which logs emails to the
# server console instead of sending them.
RESEND_API_KEY=""

# "From" address used when sending reminder emails via Resend.
EMAIL_FROM="JustBaby Luv <reminders@justbabyluv.com>"
